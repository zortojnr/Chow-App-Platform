# ==============================================================
# Chow Here — Environment Variables
# ==============================================================
# Copy this file to .env and fill in values for local development.
# NEVER commit .env — only .env.example is committed.
# ==============================================================

# -----------------------------------------------
# DATABASE — Supabase
# -----------------------------------------------
# Two connection strings are required. Prisma uses DATABASE_URL for all
# application queries and DIRECT_URL exclusively for migrations.
#
# DATABASE_URL  → Transaction mode pooler (PgBouncer, port 6543)
#                 Used by Prisma Client at runtime. Serverless-safe.
#                 Must include ?pgbouncer=true to disable prepared statements.
#                 Format: postgres://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL    → Direct connection (port 5432, bypasses PgBouncer)
#                 Used only by `prisma migrate` and `prisma db push`.
#                 Required because PgBouncer drops the advisory locks that
#                 Prisma migrate depends on for safe concurrent migration.
#                 Format: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#
# Both values are in: Supabase Dashboard → Project Settings → Database → Connection string
#
# IPv4 note: The direct connection (DIRECT_URL) is IPv6 by default on Supabase.
# If your environment is IPv4-only, use the session mode pooler on port 5432
# as DIRECT_URL instead:
#   postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------
# AUTHENTICATION
# -----------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------
# CLOUDINARY (Media Storage)
# -----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------
# RESEND (Transactional Email)
# -----------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------
# APPLICATION
# -----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Values: development | staging | production
NEXT_PUBLIC_APP_ENV=development
